# Copy to .env, or just run `python set_password.py` to create it.
# Never commit the real .env file.

# Created by set_password.py
ADMIN_PASSWORD_HASH=
SECRET_KEY=

# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# How long an admin login lasts
SESSION_HOURS=12

# Set to true when served over HTTPS (always in production)
COOKIE_SECURE=false

# Interactive API docs at /docs; set to false in production
ENABLE_DOCS=true

# Optional overrides
# DATABASE_URL=sqlite:///C:/path/to/news_blog.db
# UPLOAD_DIR=C:/path/to/uploads
