# Settings for the LIVE site. Copy to backend/.env on the server, then run
# `python set_password.py` there to add ADMIN_PASSWORD_HASH and SECRET_KEY.

SITE_URL=https://dailycurrent.example.com
CORS_ORIGINS=https://dailycurrent.example.com
COOKIE_SECURE=true
ENABLE_DOCS=false
SESSION_HOURS=12

# Keep data outside the code folder (and outside any synced folder)
DATABASE_URL=sqlite:////srv/dailycurrent/data/news_blog.db
UPLOAD_DIR=/srv/dailycurrent/data/uploads
BACKUP_DIR=/srv/dailycurrent/backups
KEEP_BACKUPS=14
